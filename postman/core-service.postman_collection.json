          "name": "Create Product",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{supplier_token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"product_name\": \"Fresh Apples\",\n  \"category_id\": 1,\n  \"unit\": \"kg\",\n  \"stock\": 100,\n  \"price\": 25000,\n  \"description\": \"Crisp red apples\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/supplier/products", "host": ["{{base_url}}"], "path": ["supplier", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.collectionVariables.set('product_id', body.data.id);",
                  "  if (body.data && body.data.product_slug) pm.collectionVariables.set('product_slug', body.data.product_slug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{supplier_token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"product_name\": \"Fresh Apples (Updated)\",\n  \"category_id\": 1,\n  \"unit\": \"kg\",\n  \"price\": 27000,\n  \"description\": \"Crisp red apples, updated\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/supplier/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["supplier", "products", "{{product_id}}"] }
          }
        },
