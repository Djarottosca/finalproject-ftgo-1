                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.token) pm.collectionVariables.set('supplier_token', body.data.token);",
                  "  if (body.data && body.data.supplier && body.data.supplier.id) pm.collectionVariables.set('supplier_id', body.data.supplier.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"janesupplier\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/supplier/login", "host": ["{{base_url}}"], "path": ["supplier", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.token) pm.collectionVariables.set('supplier_token', body.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{supplier_token}}" }] },
            "url": { "raw": "{{base_url}}/supplier/logout", "host": ["{{base_url}}"], "path": ["supplier", "logout"] }
          }
        },
        {
          "name": "Get Supplier Profile",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{supplier_token}}" }] },
            "url": { "raw": "{{base_url}}/suppliers/{{supplier_id}}", "host": ["{{base_url}}"], "path": ["suppliers", "{{supplier_id}}"] }
          }
        },
        {
          "name": "List My Products",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{supplier_token}}" }] },
            "url": { "raw": "{{base_url}}/supplier/products", "host": ["{{base_url}}"], "path": ["supplier", "products"] }
          }
        },
