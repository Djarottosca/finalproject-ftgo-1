# ── core-service ────────────────────────────────
CORE_ENV=development
CORE_HOST=localhost
CORE_PORT=8080
JWT_SECRET=change-me-in-production

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=proyekin_db
