# Copy this file to .env and fill in the required values.
# Shared by core-service, payment-service, and notification-service.

# ── core-service ─────────────────────────────────

# App & Auth
CORE_ENV=development
CORE_HOST=localhost
CORE_PORT=8080
JWT_SECRET= # required

# Downstream gRPC addresses (as seen by core-service)
NOTIFICATION_SERVICE_ADDR=localhost:9002
PAYMENT_SERVICE_ADDR=localhost:9001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=proyekin_db
DB_SSLMODE=disable # disable | require | verify-full

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RajaOngkir
RAJAONGKIR_BASE_URL=
RAJAONGKIR_API_KEY=

# ── payment-service ──────────────────────────────

# App
PAYMENT_ENV=development
PAYMENT_HOST=localhost
PAYMENT_GRPC_PORT=9001
PAYMENT_BASE_URL=http://localhost:9001

# Provider switch
PAYMENT_PROVIDER=simulation # simulation | xendit
PAYMENT_INVOICE_TTL=24h # Go duration format (h/m/s)

# Xendit integration (required when PAYMENT_PROVIDER=xendit)
XENDIT_API_KEY= # required
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_RETURN_URL=https://example.com/orders
XENDIT_HTTP_TIMEOUT=15s # Go duration format (h/m/s)
XENDIT_CURRENCY=IDR
XENDIT_COUNTRY=ID

# ── notification-service ─────────────────────────

# App
NOTIFICATION_ENV=development
NOTIFICATION_HOST=localhost
NOTIFICATION_PORT=9002

# Email provider switch
EMAIL_PROVIDER=mailjet # mailjet | appscript

# Mailjet credentials
MAILJET_API_KEY= # required
MAILJET_API_SECRET= # required
MAILJET_SENDER_EMAIL= # required
MAILJET_SENDER_NAME= # required

# AppScript credentials
APPSCRIPT_WEBAPP_URL= # required
APPSCRIPT_SECRET= # required
